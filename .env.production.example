# ==============================================================================
# MaaHifazat AI — Production Environment Variables Configuration Template
# COPY THIS FILE TO .env ON THE PRODUCTION SERVER AND SET SECURE VALUES.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Mode
DEBUG=False
APP_NAME="MaaHifazat AI"
APP_VERSION="1.0.0"

# Server Bind Settings
HOST=127.0.0.1
PORT=8000
WORKERS=4

# JWT Authentication (CRITICAL: CHANGE THIS IN PRODUCTION)
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Database Connection (Async SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:////var/lib/maahifazat/maahifazat.db

# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# External Service Integration Stubs
VOICE_API_URL=http://127.0.0.1:8001/voice
FACILITY_API_URL=https://overpass-api.de/api/interpreter
ROUTING_API_URL=https://api.openrouteservice.org
MESSAGING_API_URL=http://127.0.0.1:8002/messaging
