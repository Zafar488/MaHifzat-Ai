# Local configuration example; do not commit actual keys.
APP_ENV=development
DEMO_MODE=false
APP_DEBUG=false
ENABLE_LLM=false
REQUIRE_MODELS=true
# Real launcher preserves DATABASE_URL; isolated test launcher uses data/demo-app.db.
# DATABASE_URL=sqlite+aiosqlite:///F:/hackthon/data/local-app.db
# Production requires postgresql+asyncpg://... and explicit JWT_SECRET.
# JWT_SECRET=replace_with_a_secure_random_value_of_at_least_32_characters
# FACILITY_DIRECTORY_PATH=F:/hackthon/config/verified_facilities.json
FACILITY_VERIFICATION_MAX_DAYS=365
OPENROUTESERVICE_API_KEY=
ROUTING_TIMEOUT_SECONDS=8
FOLLOWUP_TIMEZONE=Asia/Karachi
GROQ_API_KEY=
BACKEND_URL=http://127.0.0.1:8000

GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25
OVERPASS_URL=https://overpass.private.coffee/api/interpreter
OSM_MAP_FALLBACK_URL=https://api.openstreetmap.org/api/0.6/map.json
HOSPITAL_SEARCH_TIMEOUT_SECONDS=25
